# Токен бота от @BotFather
BOT_TOKEN=123456:ABCDEF...

# Прокси до api.telegram.org. Нужен, только если Telegram с сервера не
# открывается (частая история на российских хостингах): бот падает с
# TelegramNetworkError. Проверить: python scripts/check_telegram.py --tries 10
# TELEGRAM_PROXY=socks5://логин:пароль@адрес:1080

# Путь к файлу базы SQLite
DB_PATH=data/bot.sqlite3

# Часовой пояс, в котором пользователи задают время рассылки
TZ_NAME=Europe/Moscow

# Базовый адрес расписания СПбГУ
TIMETABLE_BASE_URL=https://timetable.spbu.ru

# Учебная группа MiM на сайте расписания: идентификатор из адреса
# https://timetable.spbu.ru/GSOM/StudentGroupEvents/Primary/474489/...
GROUP_ID=474489
DIVISION_ALIAS=GSOM
PROGRAM_TITLE=Master in Management, 2026

# Список студентов с когортами. По умолчанию берётся из bot/roster/mim_2026.json;
# укажите путь, если храните список вне репозитория (это персональные данные).
# ROSTER_PATH=/opt/timetable_spbu/data/mim_2026.json

# Время жизни кэша ответов сайта, секунды
HTTP_CACHE_TTL=900

# Таймаут HTTP-запросов, секунды
HTTP_TIMEOUT=20

# Как часто проверять расписание на изменения (часы) и на сколько дней вперёд
CHANGE_CHECK_HOURS=3
CHANGE_WINDOW_DAYS=14

# Уровень логирования
LOG_LEVEL=INFO
